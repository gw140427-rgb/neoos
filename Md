name: Windows Runner

on:
  workflow_dispatch:

jobs:
  windows:
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Show system info
        run: |
          systeminfo
          hostname

      - name: Keep runner alive
        shell: powershell
        run: |
          Write-Host "Runner is running..."
          Start-Sleep -Seconds 1800
